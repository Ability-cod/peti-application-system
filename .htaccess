# Basic security hardening for the whole site.

# Stop Apache from listing folder contents when there's no index file
# (e.g. someone visiting /uploads/ directly would otherwise see every
# filename in it).
Options -Indexes

<IfModule mod_headers.c>
    # Stop the site from being embedded in an <iframe> on another site
    # (clickjacking protection).
    Header always set X-Frame-Options "SAMEORIGIN"

    # Stop the browser from guessing a file's type differently than the
    # server declares (reduces certain XSS/content-sniffing attacks).
    Header always set X-Content-Type-Options "nosniff"

    # Only send the origin (not the full URL with query strings) in the
    # Referer header when linking to other sites.
    Header always set Referrer-Policy "strict-origin-when-cross-origin"
</IfModule>

# Never allow this file itself, or any other .htaccess, to be
# downloaded/viewed directly.
<Files ".htaccess">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order deny,allow
        Deny from all
    </IfModule>
</Files>